#!/bin/sh

# Displays the number of pending updates for official and AUR packages.
# When clicked, it opens a terminal to run the upgrade.

icon=""
cache_file="$HOME/.cache/pending_updates"

# Asynchronously check for updates and write to cache.
# This prevents the status bar from freezing.
(
	# Check for official repository updates
	official_updates=$(checkupdates 2>/dev/null)

	# Check for AUR updates (using yay in this example)
	aur_updates=$(yay -Qu 2>/dev/null)

	# Combine and write to cache
	printf "%s\n%s" "$official_updates" "$aur_updates" | sed '/^\s*$/d' > "$cache_file"

	# Signal dwmblocks to update this module (signal 8 is RTMIN+8)
	# Check if dwmblocks is running before sending a signal
	pidof -s dwmblocks >/dev/null && pkill -RTMIN+8 dwmblocks

) &

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e bash -c 'echo "Checking for updates..."; yay -Syu; echo "Press enter to exit..."; read' ;;
	2) notify-send "Pending Updates" "$(cat "$cache_file")" ;;
	3) notify-send "$icon Updates" "Shows pending updates from official and AUR repos.\n- Left-click to upgrade all.\n- Middle-click to list all pending updates." ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Read update count from cache
if [ -f "$cache_file" ]; then
	updates=$(wc -l < "$cache_file")
else
	updates=0
fi

# Display the count if there are updates
if [ "$updates" -gt 0 ]; then
	if [ ! -e "$HOME/.cache/bar_color" ]; then
		echo "$icon $updates"
	else
		# Using dwm status2d colors for compatibility with your sb-arch.sh
		# ^c#a48ead^ is foreground, ^d^ resets to default colors.
		echo "^c#a48ead^$icon ^d^$updates"
	fi
fi
