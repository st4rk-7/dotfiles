#!/bin/sh
# Display currently playing music.

case "$BLOCK_BUTTON" in
    1) musicctl prev ;;
    2) musicctl toggle ;;
    3) musicctl next ;;
    4) musicctl seek +5 ;;
    5) musicctl seek -5 ;;
    6) terminal -e "$EDITOR" "$0" ;;
esac

get_player() {
    playing_player=""
    paused_player=""
    for player in $(playerctl -l 2>/dev/null); do
        status=$(playerctl --player="$player" status 2>/dev/null)
        if [ "$status" = "Playing" ]; then
            playing_player="$player"
            break
        elif [ "$status" = "Paused" ]; then
            paused_player="$player"
        fi
    done

    if [ -n "$playing_player" ]; then
        echo "$playing_player"
    elif [ -n "$paused_player" ]; then
        echo "$paused_player"
    fi
}

PLAYER=$(get_player)

if [ -z "$PLAYER" ]; then
    exit 1
fi

status="$(playerctl --player="$PLAYER" --no-messages status)" || exit 1
case "$status" in
    Stopped) exit ;;
    Paused) icon="" ;;
    Playing) icon="󰝚" ;;
esac

song="$(playerctl --player="$PLAYER" metadata --format='{{title}} - {{artist}}')" || exit 2

# Set your desired maximum length
maxlen=15

# Check if the song string is longer than the max length
if [ ${#song} -gt $maxlen ]; then
    # If it is, truncate it with `cut` and add an ellipsis
    song=$(echo "$song" | cut -c 1-"$maxlen")...
fi

echo "$icon $song"
