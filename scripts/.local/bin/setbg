#!/bin/sh

# setbg: Set desktop wallpaper and optionally st background
# Usage: setbg [-s] [-f] [-m mode] [file|directory]
#   -s: Silent mode (no notifications)
#   -f: Skip Farbfeld conversion for st (for picom blur)
#   -m: Matugen mode (dark or light, defaults to dark)

# Location of wallpaper symlink
bgloc="${XDG_DATA_HOME:-$HOME/.local/share}/bg"

# Location of Farbfeld symlink for st
st_bgloc="${XDG_DATA_HOME:-$HOME/.local/share}/st-bg.ff"

# Default wallpaper directory
default_dir="$HOME/Pictures/Wallpapers"

# Handle options
silent=0
skip_ff=0
matugen_mode="dark" # Default matugen mode
while getopts "sfm:" o; do
    case "${o}" in
        s) silent=1 ;;
        f) skip_ff=1 ;;
        m) matugen_mode="${OPTARG}" ;;
        *) echo "Usage: $0 [-s] [-f] [-m mode] [file|directory]"; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

# Validate and set wallpaper
trueloc="$(readlink -f "$1")"
if [ -n "$trueloc" ]; then
    case "$(file --mime-type -b "$trueloc")" in
        image/*)
            img="$trueloc"
            ln -sf "$trueloc" "$bgloc"
            [ "$silent" -eq 0 ] && notify-send -i "$bgloc" "Wallpaper applied..."
            ;;
        inode/directory)
            img=$(find "$trueloc" -iregex '.*\.\(jpg\|jpeg\|png\|gif\)' -type f | shuf -n 1)
            [ -z "$img" ] && { [ "$silent" -eq 0 ] && notify-send "󰋩 Error" "No images found in directory."; exit 1; }
            ln -sf "$img" "$bgloc"
            [ "$silent" -eq 0 ] && notify-send -i "$bgloc" "Random Wallpaper chosen."
            ;;
        *)
            [ "$silent" -eq 0 ] && notify-send "󰋩 Error" "Not a valid image or directory."
            exit 1
            ;;
    esac
else
    # No argument: use random image from default_dir
    img=$(find "$default_dir" -iregex '.*\.\(jpg\|jpeg\|png\|gif\)' -type f | shuf -n 1)
    [ -z "$img" ] && { [ "$silent" -eq 0 ] && notify-send "󰋩 Error" "No images found in $default_dir."; exit 1; }
    ln -sf "$img" "$bgloc"
    [ "$silent" -eq 0 ] && notify-send -i "$bgloc" "Random Wallpaper chosen from $default_dir."
fi

# Set wallpaper with xwallpaper
xwallpaper --zoom "$bgloc"

# Generate color scheme with matugen
if command -v matugen >/dev/null 2>&1; then
    matugen image "$img" -m "$matugen_mode" || { [ "$silent" -eq 0 ] && notify-send "󰋩 Error" "Matugen failed to generate colors."; }
else
    [ "$silent" -eq 0 ] && notify-send "󰋩 Warning" "Matugen not found. Skipping color scheme generation."
fi

# Convert to Farbfeld for st unless -f is used
if [ "$skip_ff" -eq 0 ] && command -v convert >/dev/null 2>&1; then
    img_target="$(readlink -f "$bgloc")"
    ff_target="${XDG_CACHE_HOME:-$HOME/.cache}/st-bg-$(basename "$img_target" | sed 's/\.[^.]*$/.ff/')"
    convert "$img_target" "$ff_target" 2>/dev/null || { [ "$silent" -eq 0 ] && notify-send "󰋩 Error" "Failed to convert to Farbfeld."; exit 1; }
    ln -sf "$ff_target" "$st_bgloc"
    [ "$silent" -eq 0 ] && notify-send -i "$st_bgloc" "st background set (Farbfeld)."
else
    [ "$skip_ff" -eq 1 ] && [ "$silent" -eq 0 ] && notify-send "st background" "Farbfeld conversion skipped (-f)."
fi
