#!/usr/bin/env python3
# encoding:utf8
"""Tuned-adm command line dmenu script.

This script provides a dmenu interface to select and activate a tuned profile.
"""

import sys
import subprocess

# --- Configuration ---
# You can change 'dmenu' to 'rofi -dmenu -i' or any other dmenu-compatible menu.
DMENU_CMD = ["dmenu", "-c", "-i", "-l", "15", "-bw", "2", "-p", "Select Tuned Profile:"]
# Character to show next to the active profile.
ACTIVE_CHAR = "*"
# --- End Configuration ---


def notify(message, urgency="low"):
    """Use notify-send to show a desktop notification if available."""
    try:
        subprocess.run(["notify-send", "-u", urgency, "-a", "dmenu-tuned", message], check=False)
    except FileNotFoundError:
        pass  # notify-send not installed


def get_tuned_profiles():
    """Get a list of available tuned profiles."""
    try:
        result = subprocess.run(['tuned-adm', 'list'], capture_output=True, text=True, check=True)
        lines = result.stdout.strip().split('\n')
        # Extract profile names which start with '- '. Take only the first word
        # to ignore descriptions, e.g. "- virtual-host - Optimize for running KVM guests"
        profiles = [line[2:].strip().split()[0] for line in lines if line.startswith('- ')]
        return sorted(profiles)
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        notify(f"Error getting tuned profiles: {e}", urgency="critical")
        return []


def get_active_tuned_profile():
    """Get the currently active tuned profile."""
    try:
        result = subprocess.run(['tuned-adm', 'active'], capture_output=True, text=True, check=True)
        line = result.stdout.strip()
        if line.startswith('Current active profile: '):
            return line.replace('Current active profile: ', '').strip()
        return "off"  # Tuned is likely off or not reporting a profile
    except (subprocess.CalledProcessError, FileNotFoundError):
        return "off"


def set_profile(profile_name):
    """Activate a tuned profile or turn tuned off."""
    command = ['sudo', 'tuned-adm']
    if profile_name == "off":
        command.append('off')
        message = "Tuned has been turned off."
    else:
        command.extend(['profile', profile_name])
        message = f"Tuned profile set to: {profile_name}"

    try:
        subprocess.run(command, check=True, capture_output=True, text=True)
        notify(message)
    except subprocess.CalledProcessError as e:
        error_msg = e.stderr.strip() if e.stderr else str(e)
        notify(f"Error setting profile: {error_msg}", urgency="critical")
    except FileNotFoundError:
        notify("Error: 'sudo' or 'tuned-adm' not found.", urgency="critical")


def main():
    """Main script entrypoint."""
    try:
        subprocess.run(['which', 'tuned-adm'], check=True, capture_output=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        notify("tuned-adm is not installed.", urgency="critical")
        sys.exit(1)

    profiles = get_tuned_profiles()
    if not profiles:
        notify("No tuned profiles found.", urgency="normal")
        sys.exit(0)

    active_profile = get_active_tuned_profile()

    # Add 'off' to the list of profiles
    all_options = profiles + ["off"]

    # Prepare the list for dmenu, marking the active one
    menu_input = []
    for option in all_options:
        prefix = f"{ACTIVE_CHAR} " if option == active_profile else "  "
        menu_input.append(f"{prefix}{option}")

    # Run dmenu
    dmenu_process = subprocess.run(
        DMENU_CMD,
        capture_output=True,
        check=False,
        input="\n".join(menu_input),
        encoding='utf-8'
    )

    selected_text = dmenu_process.stdout.strip()

    # Exit if nothing was selected
    if not selected_text:
        sys.exit()

    # Extract the profile name from the selection
    # It might have the active character prefix, so we strip it.
    chosen_profile = selected_text.lstrip(f"{ACTIVE_CHAR} ").strip()

    # Activate the selected profile
    if chosen_profile in all_options:
        set_profile(chosen_profile)
    else:
        notify(f"Invalid selection: {chosen_profile}", urgency="critical")
        sys.exit(1)


if __name__ == '__main__':
    main()