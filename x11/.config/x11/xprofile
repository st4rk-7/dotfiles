#!/bin/sh

# This is the entry point for graphical logins (like SDDM).

# Make systemd/D-Bus aware of the graphical session so portals work.
# (This fixes the VS Code file picker issue).
dbus-update-activation-environment --systemd --all

# Load your Xresources settings.
xrdb -merge "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources"

# Hand off control completely to your main autostart script.
exec "$HOME/.local/bin/autostart"